# ============================================================
#  AWARE-AI — Production Environment Configuration Template
# ============================================================

# Application Identity & Server Mode
APP_NAME=AWARE-AI
ENVIRONMENT=production
DEBUG=False
PORT=8501
HOST=0.0.0.0

# Database Persistence (Default SQLite WAL mode)
# For local SQLite: sqlite:///aware_ai.db
# For absolute path: sqlite:////app/data/aware_ai.db
DATABASE_URL=sqlite:///aware_ai.db

# Open-Meteo Weather API Integration
# Open-Meteo standard non-commercial tier requires no API key.
# For commercial enterprise tier with custom endpoints / customer key:
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
WEATHER_CACHE_TTL_SECONDS=600

# Machine Learning & SHAP Runtime
MODEL_ARTIFACT_DIR=ml/models
ML_DELAY_PROBABILITY_THRESHOLD=0.50
COMPOSITE_RISK_HIGH_THRESHOLD=0.65
COMPOSITE_RISK_CRITICAL_THRESHOLD=0.85

# Multi-Agent Swarm Orchestration
AGENT_EXECUTION_TIMEOUT_SECONDS=30
ENABLE_PARALLEL_AGENT_EXECUTION=False

# Human Approval & Governance
ENFORCE_HUMAN_APPROVAL_FOR_DISPATCH=True

# Logging
LOG_LEVEL=INFO
